-- ========== MORPH BUTTON ==========
local function createMorphBtn(morphObj, folderName, parent)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(0.97, 0, 0, 32)
	row.BackgroundColor3 = Color3.fromRGB(38, 38, 46)
	row.BorderSizePixel = 0
	row.Parent = parent

	local rc = Instance.new("UICorner")
	rc.CornerRadius = UDim.new(0, 5)
	rc.Parent = row

	local nameLbl = Instance.new("TextLabel")
	nameLbl.Size = UDim2.new(0.55, -8, 1, 0)
	nameLbl.Position = UDim2.new(0, 8, 0, 0)
	nameLbl.BackgroundTransparency = 1
	nameLbl.Text = morphObj.Name
	nameLbl.TextColor3 = Color3.fromRGB(230, 230, 235)
	nameLbl.TextSize = 12
	nameLbl.TextXAlignment = Enum.TextXAlignment.Left
	nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
	nameLbl.Font = Enum.Font.Gotham
	nameLbl.Parent = row

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 62, 0, 22)
	btn.Position = UDim2.new(1, -68, 0.5, -11)
	btn.BackgroundColor3 = Color3.fromRGB(70, 130, 240)
	btn.Text = "Morph"
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 12
	btn.Font = Enum.Font.GothamBold
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Parent = row

	local btnC = Instance.new("UICorner")
	btnC.CornerRadius = UDim.new(0, 5)
	btnC.Parent = btn

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(100, 160, 255)}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(70, 130, 240)}):Play()
	end)

	btn.MouseButton1Click:Connect(function()
		local args = { "morph", morphObj }
		ReplicatedStorage.MorphEvent:FireServer(unpack(args))

		btn.Text = "OK"
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(60, 200, 100)}):Play()
		task.wait(0.35)
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(70, 130, 240)}):Play()
		task.wait(0.12)
		btn.Text = "Morph"
	end)
end

-- ========== FOLDER SECTION ==========
local function createFolderSection(folderName, folder)
	local header = Instance.new("Frame")
	header.Size = UDim2.new(0.97, 0, 0, 30)
	header.BackgroundColor3 = Color3.fromRGB(52, 52, 62)
	header.BorderSizePixel = 0
	header.ClipsDescendants = true
	header.Parent = Scroll

	local hc = Instance.new("UICorner")
	hc.CornerRadius = UDim.new(0, 6)
	hc.Parent = header

	local headerBar = Instance.new("TextButton")
	headerBar.Size = UDim2.new(1, 0, 0, 30)
	headerBar.BackgroundTransparency = 1
	headerBar.Text = ""
	headerBar.Parent = header

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(0.7, -10, 1, 0)
	title.Position = UDim2.new(0, 10, 0, 0)
	title.BackgroundTransparency = 1
	title.Text = folderName:upper()
	title.TextColor3 = Color3.fromRGB(255, 210, 120)
	title.TextSize = 12
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Font = Enum.Font.GothamBold
	title.Parent = header

	local countLbl = Instance.new("TextLabel")
	countLbl.Size = UDim2.new(0, 40, 1, 0)
	countLbl.Position = UDim2.new(1, -70, 0, 0)
	countLbl.BackgroundTransparency = 1
	countLbl.Text = "0"
	countLbl.TextColor3 = Color3.fromRGB(150, 150, 160)
	countLbl.TextSize = 11
	countLbl.Font = Enum.Font.Gotham
	countLbl.Parent = header

	local arrow = Instance.new("TextLabel")
	arrow.Size = UDim2.new(0, 24, 1, 0)
	arrow.Position = UDim2.new(1, -26, 0, 0)
	arrow.BackgroundTransparency = 1
	arrow.Text = ">"
	arrow.TextColor3 = Color3.fromRGB(200, 200, 210)
	arrow.TextSize = 11
	arrow.Font = Enum.Font.GothamBold
	arrow.Parent = header

	local morphHolder = Instance.new("Frame")
	morphHolder.Size = UDim2.new(1, -6, 0, 0)
	morphHolder.Position = UDim2.new(0, 3, 0, 34)
	morphHolder.BackgroundTransparency = 1
	morphHolder.AutomaticSize = Enum.AutomaticSize.Y
	morphHolder.ClipsDescendants = true
	morphHolder.Visible = false
	morphHolder.Parent = header

	local mLayout = Instance.new("UIListLayout")
	mLayout.Padding = UDim.new(0, 3)
	mLayout.SortOrder = Enum.SortOrder.Name
	mLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	mLayout.Parent = morphHolder

	local count = 0
	for _, child in pairs(folder:GetChildren()) do
		createMorphBtn(child, folderName, morphHolder)
		count = count + 1
	end
	countLbl.Text = tostring(count)

	local expanded = false
	headerBar.MouseButton1Click:Connect(function()
		expanded = not expanded
		if expanded then
			morphHolder.Visible = true
			arrow.Text = "v"
			TweenService:Create(header, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
				Size = UDim2.new(0.97, 0, 0, 38 + count * 35)
			}):Play()
		else
			arrow.Text = ">"
			TweenService:Create(header, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
				Size = UDim2.new(0.97, 0, 0, 30)
			}):Play()
			task.wait(0.18)
			morphHolder.Visible = false
		end
	end)

	return header, count
end

-- ========== BUILD ==========
local total = 0
for _, name in ipairs(folderNames) do
	local folder = MorphFolder:FindFirstChild(name)
	if folder then
		local _, c = createFolderSection(name, folder)
		total = total + c
	else
		warn("[MorphSelector] Missing folder: " .. name)
	end
end

if total == 0 then
	local empty = Instance.new("TextLabel")
	empty.Size = UDim2.new(1, 0, 0, 30)
	empty.BackgroundTransparency = 1
	empty.Text = "No morphs found"
	empty.TextColor3 = Color3.fromRGB(200, 200, 200)
	empty.TextSize = 12
	empty.Font = Enum.Font.Gotham
	empty.Parent = Scroll
end

-- ========== RESET (kill player to reset) ==========
ResetBtn.MouseEnter:Connect(function()
	TweenService:Create(ResetBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(220, 80, 80)}):Play()
end)
ResetBtn.MouseLeave:Connect(function()
	TweenService:Create(ResetBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(200, 60, 60)}):Play()
end)

ResetBtn.MouseButton1Click:Connect(function()
	ResetBtn.Text = "Resetting..."
	ResetBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 100)

	local char = Player.Character
	if char then
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			pcall(function()
				ReplicatedStorage.MorphEvent:FireServer("reset")
			end)
			task.wait(0.15)
			if humanoid.Parent and humanoid.Health > 0 then
				humanoid.Health = 0
			end
		end
	end

	task.wait(0.4)
	ResetBtn.Text = "Reset Character"
	ResetBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
end)

print(("[MorphSelector] Loaded - %d morphs across %d folders"):format(total, #folderNames))
