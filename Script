-- Helper: create a single morph button
local function createMorphBtn(morphObj, folderName, parentContainer)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(0.94, 0, 0, 38)
	container.BackgroundColor3 = Color3.fromRGB(40, 40, 46)
	container.BackgroundTransparency = 0.2
	container.BorderSizePixel = 0
	container.Parent = parentContainer

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = container

	-- Name
	local nameLbl = Instance.new("TextLabel")
	nameLbl.Size = UDim2.new(0.6, -5, 1, 0)
	nameLbl.Position = UDim2.new(0, 10, 0, 0)
	nameLbl.BackgroundTransparency = 1
	nameLbl.Text = morphObj.Name
	nameLbl.TextColor3 = Color3.fromRGB(235,235,235)
	nameLbl.TextScaled = true
	nameLbl.TextXAlignment = Enum.TextXAlignment.Left
	nameLbl.Font = Enum.Font.Gotham
	nameLbl.Parent = container

	-- Folder tag
	local tag = Instance.new("TextLabel")
	tag.Size = UDim2.new(0.2, -5, 0.55, 0)
	tag.Position = UDim2.new(0.6, 0, 0.5, -10)
	tag.BackgroundColor3 = Color3.fromRGB(60,60,72)
	tag.BackgroundTransparency = 0.3
	tag.Text = folderName:upper()
	tag.TextColor3 = Color3.fromRGB(190,190,190)
	tag.TextScaled = true
	tag.Font = Enum.Font.Gotham
	tag.Parent = container
	local tagC = Instance.new("UICorner")
	tagC.CornerRadius = UDim.new(0, 4)
	tagC.Parent = tag

	-- Morph button
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.18, -5, 0.7, 0)
	btn.Position = UDim2.new(0.8, -5, 0.5, -12)
	btn.BackgroundColor3 = Color3.fromRGB(70, 140, 255)
	btn.Text = "Morph"
	btn.TextColor3 = Color3.fromRGB(255,255,255)
	btn.TextScaled = true
	btn.Font = Enum.Font.GothamBold
	btn.BorderSizePixel = 0
	btn.Parent = container

	local btnC = Instance.new("UICorner")
	btnC.CornerRadius = UDim.new(0, 4)
	btnC.Parent = btn

	-- Hover
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(100, 170, 255) }):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(70, 140, 255) }):Play()
	end)

	-- Click → fire remote with the exact Instance
	btn.MouseButton1Click:Connect(function()
		local args = { "morph", morphObj }
		ReplicatedStorage.MorphEvent:FireServer(unpack(args))

		-- Visual feedback
		btn.Text = "✓"
		TweenService:Create(btn, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(50, 200, 50) }):Play()
		task.wait(0.3)
		TweenService:Create(btn, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(70, 140, 255) }):Play()
		task.wait(0.2)
		btn.Text = "Morph"
	end)
end

-- Create a folder header + morph container (collapsed by default)
local function createFolderSection(folderName, folder)
	-- Header
	local header = Instance.new("Frame")
	header.Size = UDim2.new(0.94, 0, 0, 34)  -- will be adjusted later
	header.BackgroundColor3 = Color3.fromRGB(55, 55, 64)
	header.BorderSizePixel = 0
	header.Parent = Scroll

	local hCorner = Instance.new("UICorner")
	hCorner.CornerRadius = UDim.new(0, 8)
	hCorner.Parent = header

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(0.85, -10, 1, 0)
	title.Position = UDim2.new(0, 12, 0, 0)
	title.BackgroundTransparency = 1
	title.Text = "📁 " .. folderName:upper()
	title.TextColor3 = Color3.fromRGB(255, 220, 140)
	title.TextScaled = true
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Font = Enum.Font.GothamBold
	title.Parent = header

	local toggle = Instance.new("TextButton")
	toggle.Size = UDim2.new(0, 30, 0, 30)
	toggle.Position = UDim2.new(1, -34, 0, 2)
	toggle.BackgroundColor3 = Color3.fromRGB(65, 65, 75)
	toggle.Text = "▶"   -- collapsed by default
	toggle.TextColor3 = Color3.fromRGB(255,255,255)
	toggle.TextScaled = true
	toggle.Font = Enum.Font.GothamBold
	toggle.BorderSizePixel = 0
	toggle.Parent = header

	local tCorner = Instance.new("UICorner")
	tCorner.CornerRadius = UDim.new(0, 5)
	tCorner.Parent = toggle

	-- Container for morphs (hidden initially)
	local morphContainer = Instance.new("Frame")
	morphContainer.Size = UDim2.new(1, 0, 0, 0)
	morphContainer.BackgroundTransparency = 1
	morphContainer.AutomaticSize = Enum.AutomaticSize.Y
	morphContainer.ClipsDescendants = true
	morphContainer.Visible = false   -- start collapsed
	morphContainer.Parent = header

	local mLayout = Instance.new("UIListLayout")
	mLayout.Padding = UDim.new(0, 4)
	mLayout.SortOrder = Enum.SortOrder.Name
	mLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	mLayout.Parent = morphContainer

	-- Populate morphs
	local count = 0
	for _, child in pairs(folder:GetChildren()) do
		-- treat every direct child as a morph
		createMorphBtn(child, folderName, morphContainer)
		count = count + 1
	end

	-- Set initial height (only header visible)
	header.Size = UDim2.new(0.94, 0, 0, 34)

	-- Toggle expand/collapse
	local expanded = false
	toggle.MouseButton1Click:Connect(function()
		expanded = not expanded
		if expanded then
			morphContainer.Visible = true
			toggle.Text = "▼"
			header.Size = UDim2.new(0.94, 0, 0, 34 + count * 42)
		else
			morphContainer.Visible = false
			toggle.Text = "▶"
			header.Size = UDim2.new(0.94, 0, 0, 34)
		end
	end)

	return header, count
end

-- ========== SCAN ALL FOLDERS ==========
local total = 0
for _, name in ipairs(folderNames) do
	local folder = MorphFolder:FindFirstChild(name)
	if folder then
		local _, cnt = createFolderSection(name, folder)
		total = total + cnt
	else
		warn("Folder missing: " .. name)
	end
end

if total == 0 then
	local empty = Instance.new("TextLabel")
	empty.Size = UDim2.new(1, 0, 0, 40)
	empty.BackgroundTransparency = 1
	empty.Text = "No morphs found"
	empty.TextColor3 = Color3.fromRGB(200,200,200)
	empty.TextScaled = true
	empty.Font = Enum.Font.Gotham
	empty.Parent = Scroll
end

