MinBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	if minimized then
		TweenService:Create(Main, TweenInfo.new(0.2), { Size = UDim2.new(0,400,0,36) }):Play()
		MinBtn.Text = "□"
	else
		TweenService:Create(Main, TweenInfo.new(0.2), { Size = UDim2.new(0,400,0,500) }):Play()
		MinBtn.Text = "─"
	end
end)

